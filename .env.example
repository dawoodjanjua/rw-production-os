# RW Production OS — environment variables (copy to .env.local for development).
# NEVER commit real values. On Hostinger, enter these in hPanel → your Node.js app → Environment variables.

# Supabase project (Supabase dashboard → Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# Server-only. Bypasses Row Level Security — never expose to the browser, never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public URL of this app (used in password setup links). No trailing slash.
NEXT_PUBLIC_SITE_URL=https://app.yourdomain.com

# Shared secret the external scheduler sends to /api/cron/reminders (min 24 chars). Generate: openssl rand -hex 32
CRON_SECRET=

# 32-byte key (base64) encrypting tenants' WhatsApp access tokens at rest. Generate: openssl rand -base64 32
# Keep a safe copy: if it is lost, stored WhatsApp tokens must be re-entered.
MESSAGING_ENCRYPTION_KEY=

# Official WhatsApp Business Platform (Cloud API). Leave sending OFF until a tenant is connected and tested.
WHATSAPP_SEND_ENABLED=false
WHATSAPP_API_VERSION=v23.0
# Meta app secret (verifies delivery-status webhook signatures) and the verify token you choose in the Meta app.
WHATSAPP_APP_SECRET=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
